ENV=development

# Only used to configure the container in compose.db.yml (`make dev-db`).
# The app itself only reads DATABASE_URL below — irrelevant if you're using a
# native Postgres install or a remote one like Supabase instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=service_assistant_dev
POSTGRES_HOST_AUTH_METHOD=trust

DATABASE_URL=postgresql+psycopg://postgres@host.docker.internal:5432/service_assistant_dev

ATTACHMENTS_DIR=/attachments
AUTH_TOKEN=CHANGEMELATER

# Private Cloudflare R2 bucket used by the admin benchmark page.
BENCHMARK_R2_ENDPOINT=
BENCHMARK_R2_BUCKET=
BENCHMARK_R2_ACCESS_KEY_ID=
BENCHMARK_R2_SECRET_ACCESS_KEY=
BENCHMARK_R2_PREFIX=
# Defaults to ATTACHMENTS_DIR/.benchmark_documents when empty/omitted.
# BENCHMARK_DOCUMENTS_DIR=/attachments/.benchmark_documents
BENCHMARK_JUDGE_MODEL=gpt-5.1
BENCHMARK_JUDGE_REASONING_EFFORT=high

AZURE_OPENAI_ENDPOINT=https://service-assistant-azure.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview

OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_STT_PROMPT=Nagranie zawiera wypowiedź polskiego technika serwisowego dotyczącą maszyny lub urządzenia przemysłowego. Zapisz wypowiedź możliwie dosłownie. Zachowaj dokładnie usłyszane kody błędów, oznaczenia, liczby, symbole i jednostki. Nie zgaduj brakujących informacji.
OPENAI_API_KEY=

RERANKER_ENABLED=false
VOYAGE_API_KEY=
RERANKER_MODEL=rerank-2.5
RERANKER_TIMEOUT_SECONDS=5

GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Algenib

DEEPGRAM_API_KEY=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://mc-fixo-azure-ocr.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OCR_TIMEOUT_SECONDS=30
AZURE_EMBEDDINGS_TIMEOUT_SECONDS=30
PDF_INGEST_TIMEOUT_SECONDS=600

DOCKER_SUBNET=172.28.0.0/16
DOCKER_GATEWAY=host-gateway
PORT=8000
# http://localhost:5173 is admin (vite), http://localhost:8081 is client (expo web)
# Production example: https://admin.asystent-serwisanta.pl,https://app.asystent-serwisanta.pl,https://asystent-serwisanta.pl
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
